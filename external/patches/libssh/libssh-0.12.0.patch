diff --git a/src/messages.c b/src/messages.c
index 824b2772..175588e5 100644
--- a/src/messages.c
+++ b/src/messages.c
@@ -1521,8 +1521,18 @@ int ssh_message_channel_request_open_reply_accept_channel(ssh_message msg,
     session = msg->session;
 
     chan->local_channel = ssh_channel_new_id(session);
-    chan->local_maxpacket = 35000;
-    chan->local_window = 32000;
+       /*
+        * suSSHi 2020-02-14: Set initial window to 0 and max-packet size to 32768 like OpenSSH,
+        * when receiving a channel open request from client in PubKeyAgent mode.
+        * Without, scp and sftp sessions would get stuck many times in PubKeyAgent mode.
+        *
+        * This change does not affect any other mode beside PubKeyAgent mode.
+        *
+        * chan->local_maxpacket = 35000;
+        * chan->local_window = 32000;
+        */
+       chan->local_maxpacket = 32768;
+       chan->local_window = 0;
     chan->remote_channel = msg->channel_request_open.sender;
     chan->remote_maxpacket = msg->channel_request_open.packet_size;
     chan->remote_window = msg->channel_request_open.window;
diff --git a/include/libssh/buffer-struct.h b/include/libssh/buffer-struct.h
new file mode 100644
--- /dev/null
+++ b/include/libssh/buffer-struct.h
@@ -0,0 +1,11 @@
+/* suSSHi 2020-02-14: extracted from buffer.c so consumers can include the struct definition; Copyright (c) 2003-2013 by Aris Adamantiadis */
+#ifndef LIBSSH_BUFFER_STRUCT_H
+#define LIBSSH_BUFFER_STRUCT_H
+struct ssh_buffer_struct {
+    bool secure;
+    uint32_t used;
+    uint32_t allocated;
+    uint32_t pos;
+    uint8_t *data;
+};
+#endif /* LIBSSH_BUFFER_STRUCT_H */
